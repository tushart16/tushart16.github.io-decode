<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Easy to Decode</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4">
    <div class="bg-white p-8 rounded-xl shadow-lg w-full max-w-md">
        <h1 class="text-2xl font-bold text-gray-800 mb-6 text-center">Easy to Decode</h1>
        
        <div class="space-y-4">
            <div>
                <label for="inputN" class="block text-sm font-medium text-gray-700 mb-1">Enter n</label>
                <input type="number" id="inputN" placeholder="Size n" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none">
            </div>
            
            <div>
                <label for="inputA" class="block text-sm font-medium text-gray-700 mb-1">Enter Array A</label>
                <input type="text" id="inputA" placeholder="Space separated integers" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none">
            </div>
            
            <div>
                <label for="inputB" class="block text-sm font-medium text-gray-700 mb-1">Enter Array B</label>
                <input type="text" id="inputB" placeholder="Space separated integers" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none">
            </div>
            
            <button onclick="calculateDecoder()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md transition duration-200">
                Decode
            </button>
            
            <div class="mt-6 p-4 bg-gray-50 border border-gray-200 rounded-md">
                <span class="text-sm text-gray-500 block mb-1">Result</span>
                <span id="outputResult" class="text-xl font-mono text-gray-900 font-semibold truncate block break-all">-</span>
            </div>
        </div>
    </div>

    <script>
        function calculateDecoder() {
            try {
                // Fetch input strings
                const nText = document.getElementById('inputN').value.trim();
                const aText = document.getElementById('inputA').value.trim();
                const bText = document.getElementById('inputB').value.trim();
                
                // Parse n
                const n = parseInt(nText, 10);
                if (isNaN(n) || n <= 0) {
                    document.getElementById('outputResult').innerText = "Invalid input";
                    return;
                }
                
                // Split by spaces
                const aParts = aText.split(/\s+/);
                const bParts = bText.split(/\s+/);
                
                if (aParts.length < n || bParts.length < n) {
                    document.getElementById('outputResult').innerText = "Missing elements";
                    return;
                }
                
                // 1-based indexing for Array A (using BigInt to mimic long long)
                const A = [0n];
                for (let i = 0; i < n; i++) {
                    A.push(BigInt(aParts[i]));
                }
                
                // 1-based indexing for Array B
                const B = [0];
                for (let i = 0; i < n; i++) {
                    B.push(Number(bParts[i]));
                }
                
                // Logic matching the C++ code exactly
                let ans = 0n;
                for (let i = 1; i <= n; i++) {
                    let idx = B[i];
                    
                    // Basic safeguard for array bounds accessing A
                    if (idx < 1 || idx > n) {
                        document.getElementById('outputResult').innerText = "Out of bounds";
                        return;
                    }
                    
                    // ans += (ll) i * a[b[i]];
                    ans += BigInt(i) * A[idx];
                }
                
                // Display the answer
                document.getElementById('outputResult').innerText = ans.toString();
                
            } catch (error) {
                document.getElementById('outputResult').innerText = "Error parsing inputs";
            }
        }
    </script>
</body>
</html>
